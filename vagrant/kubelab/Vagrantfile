Vagrant.configure("2") do |config|
  config.vm.network "private_network", type: "dhcp"
  config.vm.box = "bento/ubuntu-24.04"

  config.vm.define "jumpbox" do |jumpbox|
    jumpbox.vm.hostname = "jumpbox.local.dev"
    jumpbox.vm.provider "virtualbox" do |v|
      v.memory = 1024
    end
  end

  ["master", "node-01", "node-02"].each do |name|
    config.vm.define name do |entry|
      entry.vm.hostname = "#{name}.local.dev"
      entry.vm.provider "virtualbox" do |v|
        v.memory = 2048
      end
    end
  end
end

